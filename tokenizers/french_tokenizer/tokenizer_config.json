{
  "name": "french_tokenizer",
  "language": "french",
  "max_length": 15,
  "padding": "post",
  "truncation": "post",
  "vocab_size": 60,
  "preprocessor_steps": [
    "decode_html",
    "normalize_unicode",
    "expand_contractions",
    "clean_special_chars",
    "normalize_whitespace",
    "lowercase"
  ],
  "max_vocab_size": 5000,
  "min_freq": 1
}